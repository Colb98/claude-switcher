<Window x:Class="ClaudeSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Switcher" Width="1000" Height="720" MinWidth="760" MinHeight="520"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource Ink}" WindowStartupLocation="CenterScreen">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource T.RefreshUsage}" Click="RefreshUsage_Click" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource T.NewProfile}" Style="{StaticResource Primary}" Click="AddProfile_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Claude Switcher" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource T.Tagline}" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0">
            <TabItem Header="{DynamicResource T.TabProfiles}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource Card}" Padding="14">
                    <ItemsControl x:Name="ProfileList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Width="440" Margin="0,0,12,12" Background="{DynamicResource CardAlt}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding ColorBrush}" CornerRadius="3" Margin="0,2,0,2"/>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding RunBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RunState}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Account}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Plan}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <ItemsControl ItemsSource="{Binding Bars}" Margin="0,12,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,9">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Label}" FontSize="12"/>
                                                            </DockPanel>
                                                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="7" Margin="0,4,0,2"
                                                                         Foreground="{Binding Brush}" Background="{DynamicResource Track}" BorderThickness="0"/>
                                                            <TextBlock Text="{Binding Reset}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding UsageMessage}" Foreground="{DynamicResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUsageMessage}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding FetchedText}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{DynamicResource T.Open}" Style="{StaticResource Primary}" Click="Launch_Click" Tag="{Binding}" Margin="0,0,6,0" Padding="16,5"/>
                                                    <Button Content="{DynamicResource T.Stop}" Style="{StaticResource Small}" Click="Stop_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                                                    <Button Content="{DynamicResource T.Edit}" Style="{StaticResource Small}" Click="Edit_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                                                    <Button Content="⋯" Style="{StaticResource Small}" Click="More_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource T.TabTransfer}">
                <Grid Background="{DynamicResource Card}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"
                                   Text="{DynamicResource T.TransferIntro}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource T.FromProfile}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="SourceCombo" Width="220" DisplayMemberPath="Name" SelectionChanged="SourceCombo_SelectionChanged"/>
                            <CheckBox x:Name="ShowArchived" Content="{DynamicResource T.ShowArchived}" VerticalAlignment="Center" Margin="16,0,0,0"
                                      Checked="ShowArchived_Changed" Unchecked="ShowArchived_Changed"/>
                        </StackPanel>
                        <ListView Grid.Row="2" x:Name="SessionList" BorderBrush="{DynamicResource Border}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="36">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{DynamicResource T.ColTitle}" Width="360" DisplayMemberBinding="{Binding Title}"/>
                                    <GridViewColumn Header="{DynamicResource T.ColFolder}" Width="260" DisplayMemberBinding="{Binding Cwd}"/>
                                    <GridViewColumn Header="{DynamicResource T.ColActivity}" Width="110" DisplayMemberBinding="{Binding LastActivityText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                            <TextBlock Text="{DynamicResource T.ToProfile}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="TargetCombo" Width="200" DisplayMemberPath="Name"/>
                            <CheckBox x:Name="MoveSessions" IsChecked="True" Content="{DynamicResource T.MoveSessions}" VerticalAlignment="Center" Margin="16,0,0,0"
                                      ToolTip="{DynamicResource T.MoveSessionsTip}"/>
                            <CheckBox x:Name="OverwriteSessions" Content="{DynamicResource T.Overwrite}" VerticalAlignment="Center" Margin="16,0,16,0"/>
                            <Button Content="{DynamicResource T.TransferSelected}" Style="{StaticResource Primary}" Click="Transfer_Click"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource T.TabMcp}">
                <Grid Background="{DynamicResource Card}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"
                                   Text="{DynamicResource T.McpIntro}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="McpList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{DynamicResource T.McpRemoveAll}" Style="{StaticResource Small}" Click="McpRemoveAll_Click" Tag="{Binding}" VerticalAlignment="Top"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <ItemsControl ItemsSource="{Binding Toggles}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding ProfileName}" IsChecked="{Binding Enabled}" Margin="0,0,16,0"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                            <Button Content="{DynamicResource T.McpAllOn}" Click="McpAllOn_Click" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource T.McpAddJson}" Click="McpAddJson_Click" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource T.McpAddUrl}" Click="McpAddUrl_Click" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource T.Reload}" Click="McpReload_Click" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource T.Apply}" Style="{StaticResource Primary}" Click="McpApply_Click"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource T.TabSettings}">
                <Grid Background="{DynamicResource Card}">
                    <StackPanel Margin="20" MaxWidth="640" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource T.Language}" VerticalAlignment="Center" Width="190" FontSize="14"/>
                            <ComboBox x:Name="LanguageCombo" Width="160" SelectionChanged="Language_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBlock Text="{DynamicResource T.Appearance}" VerticalAlignment="Center" Width="190" FontSize="14"/>
                            <ComboBox x:Name="ThemeCombo" Width="160" SelectionChanged="Theme_Changed"/>
                        </StackPanel>
                        <CheckBox x:Name="StartWithWindows" Content="{DynamicResource T.StartWithWindows}" FontSize="14"
                                  Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"/>
                        <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="24,2,0,12"
                                   Text="{DynamicResource T.StartWithWindowsHint}"/>
                        <CheckBox x:Name="StartMinimized" Content="{DynamicResource T.StartMinimized}"
                                  Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,0,0,16"/>
                        <CheckBox x:Name="RouteNotifications" Content="{DynamicResource T.RouteNotifications}" FontSize="14"
                                  Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                        <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="24,2,0,16"
                                   Text="{DynamicResource T.RouteNotificationsHint}"/>
                        <CheckBox x:Name="RouteLinks" Content="{DynamicResource T.RouteLinks}" FontSize="14"
                                  Checked="RouteLinks_Changed" Unchecked="RouteLinks_Changed"/>
                        <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="24,2,0,16"
                                   Text="{DynamicResource T.RouteLinksHint}"/>
                        <Button x:Name="SetDefaultApp" Content="{DynamicResource T.SetDefaultApp}" Click="SetDefaultApp_Click"
                                HorizontalAlignment="Left" Margin="24,-8,0,16" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource T.RefreshEvery}" VerticalAlignment="Center" Width="190"/>
                            <ComboBox x:Name="RefreshCombo" Width="120" SelectionChanged="Settings_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource T.WarnAt}" VerticalAlignment="Center" Width="190"/>
                            <ComboBox x:Name="WarnCombo" Width="120" SelectionChanged="Settings_Changed"/>
                        </StackPanel>
                        <WrapPanel>
                            <Button Content="{DynamicResource T.OpenAppData}" Click="OpenAppData_Click" Margin="0,0,8,8"/>
                            <Button Content="{DynamicResource T.OpenBackups}" Click="OpenBackups_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBlock x:Name="LauncherInfo" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,10,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
